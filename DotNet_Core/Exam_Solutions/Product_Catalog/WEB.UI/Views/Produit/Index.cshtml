@model IEnumerable<ApplicationCore.Domain.Produit>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<form asp-action="index">
    <fieldset>
        <legend> Recherche</legend>
        <input type="text" name="nom" />
        <input type="submit" value="Serach" />
    </fieldset>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DateProd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Destination)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProduitID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategorieFK)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DateProd)
            </td>
                <td>
                    <img src="~/Uploads/@item.Destination" width="50" height="50" />
                </td>

            <td>
                @Html.DisplayFor(modelItem => item.Nom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProduitID)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.MyCategorie.Nom)
            </td>

            <td>
                    @Html.ActionLink(linkText: "Details", actionName: "Details", controllerName: "Categorie", routeValues: new { id = item.CategorieFK }, htmlAttributes: null)|


                    @Html.ActionLink("Edit", "Edit", new {  id=item.ProduitID  }) |
                    @Html.ActionLink("Details", "Details", new { /* id=item.ProduitID */ }) |
                    @Html.ActionLink("Delete", "Delete", new {  id=item.ProduitID  })
            </td>
        </tr>
}
    </tbody>
</table>
